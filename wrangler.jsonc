{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nestique",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production",
    "ENQUIRY_DELIVERY_MODE": "email",
    // Public, build-safe values. Real secrets go in Cloudflare → Settings →
    // Variables and Secrets (SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY), and in
    // .dev.vars for local `pnpm preview`.
    "NEXT_PUBLIC_SITE_URL": "https://www.nestiquestudio.in"
  }
}
